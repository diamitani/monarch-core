{
  "name": "monarch-core",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.31.0",
  "description": "Production-grade multi-agent runtime powered by Bedrock AgentCore",
  "author": "Patrick Diamitani",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "test:ci": "turbo test -- --run",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "clean": "turbo clean && rm -rf node_modules",
    "deploy:dev": "./infrastructure/scripts/deploy.sh dev",
    "deploy:prod": "./infrastructure/scripts/deploy.sh prod"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/node": "^20.14.0",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "cors": "^2.8.6"
  }
}
