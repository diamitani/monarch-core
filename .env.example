# Monarch Core Environment Variables

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock Agent IDs (created via terraform or console)
BEDROCK_RESEARCHER_AGENT_ID=
BEDROCK_PLANNER_AGENT_ID=
BEDROCK_WRITER_AGENT_ID=
BEDROCK_ORGANIZER_AGENT_ID=

# Composio Integration
COMPOSIO_API_KEY=

# API Configuration
PORT=8080
NODE_ENV=development
ALLOW_ANONYMOUS=true
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Debug
LOG_LEVEL=info
DEBUG_TRACES=false
